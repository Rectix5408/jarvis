# ═══════════════════════════════════════════════════════════════════════════════
# Jarvis AI Agent – Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM API Keys (mindestens einen eintragen) ──────────────────────────────
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter (Zugang zu 100+ Modellen): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Server-Konfiguration ───────────────────────────────────────────────────
# Öffentliche IP oder Domain für SSL-Zertifikat (wichtig für Remote-Zugriff)
SERVER_IP=127.0.0.1
SERVER_PORT=443

# Google Apps OAuth (Client-Typ: Webanwendung)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jarvis.example.com/api/google/callback

# ─── VNC / Desktop ──────────────────────────────────────────────────────────
VNC_PORT=5900
WEBSOCKIFY_PORT=6080

# ─── Sicherheit ─────────────────────────────────────────────────────────────
# Web-Login Passwort (Standard: jarvis – BITTE ÄNDERN!)
JARVIS_PASSWORD=jarvis

# Geheimer Schlüssel für HMAC-Token-Signierung (sicheren Zufallswert generieren!)
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
# Optional: Preisraten fuer hartes Cloud-Kostenbudget im Agent Studio.
# Ohne korrekte Raten werden Agenten mit Kostenbudget vor Cloud-Aufrufen gestoppt.
JARVIS_CLOUD_INPUT_COST_PER_MILLION=0
JARVIS_CLOUD_OUTPUT_COST_PER_MILLION=0
JARVIS_CLOUD_OUTPUT_TOKEN_RESERVE=4096

# Lokale Ollama-Runtime (kleiner CPU-Server: hoechstens ein geladenes Modell)
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL_DISK_PATH=/root/.ollama/models
JARVIS_MODEL_ROUTING_MODE=smart
JARVIS_LOCAL_FAST_MODEL=qwen3.5:2b
JARVIS_LOCAL_GENERAL_MODEL=qwen3.5:4b
JARVIS_LOCAL_STRONG_MODEL=
LOCAL_MAX_LOADED_MODELS=1
LOCAL_MEMORY_RESERVE_PERCENT=25
LOCAL_DISK_RESERVE_PERCENT=20
